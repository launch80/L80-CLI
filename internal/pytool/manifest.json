{
  "schema": 1,
  "tools": {
    "betterbench": {
      "repo": "https://github.com/GGZ14/BetterBench",
      "ref": "v0.6.1",
      "commit": "f72bb9011a830fd98e82ab89d01e549efa76e9c5",
      "package": "betterbench",
      "exe": "betterbench",
      "env": "L80_BETTERBENCH",
      "min_version": "0.6.1",
      "version_cmd": ["--version"],
      "notes": "Real-world percentile benchmark for OpenAI-compatible endpoints; the version launch80 renders."
    },
    "vast": {
      "repo": "https://github.com/launch80/BB-VAST-L80",
      "ref": "",
      "commit": "",
      "package": "bbvastl80",
      "exe": "bbvastl80",
      "env": "L80_VAST",
      "min_version": "0.1.0",
      "version_cmd": [],
      "notes": "Rent a Vast.ai GPU, serve a model, benchmark it with BetterBench, publish, tear down."
    },
    "pwdet": {
      "repo": "https://github.com/launch80/poisoned-weights-detector",
      "ref": "",
      "commit": "",
      "package": "pwdet",
      "exe": "pwdet",
      "env": "L80_PWDET",
      "python": "3.12",
      "extras": ["gguf", "pickle"],
      "min_version": "0.1.0",
      "version_cmd": ["--version"],
      "notes": "Poisoned Weights Detector: static, provenance, black-box and white-box checks on a checkpoint or endpoint."
    },
    "dashboard": {
      "repo": "https://github.com/launch80/ai-command-dashboard",
      "ref": "",
      "commit": "",
      "package": "ai-command-dashboard",
      "exe": "ai-dashboard",
      "env": "L80_DASHBOARD",
      "min_version": "0.1.0",
      "version_cmd": ["--version"],
      "notes": "Terminal and web dashboard for local GPU and inference telemetry."
    }
  }
}
